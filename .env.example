# =============================================================================
#  .env.example — compose.yaml が読む環境変数
#
#    cp .env.example .env  してから使う。
#
#  ★ 命名規約に関わる OTEL_* (OTEL_SERVICE_NAME / OTEL_RESOURCE_ATTRIBUTES /
#    OTEL_PROPAGATORS など) はここに書かない。コンテナ内の base/bin/otel-env.sh が
#    APP_SERVICE / APP_ROLE / APP_ENV / APP_NAMESPACE から導出する。
#    ここで上書きすると命名規約が崩れる。(詳細: docs/naming-convention.md)
#
#    otel-env.sh 自身の挙動スイッチ (ログ抑制 / Collector 待ち合わせなど) は
#    導出結果ではないので、ここで指定してよい。下の「トレース関連 WARN」を参照。
# =============================================================================

# --- 命名規約の入力 -----------------------------------------------------------
# ローカルでどの ECS サービスを再現するか。
#   intra-api / intra-web / inter-api / sf-api
# 値を変えると Jaeger の Service 名が intra-web-front のように変わる。
APP_SERVICE=intra-api

# システム識別子 (X-Ray / Jaeger の絞り込みに使う service.namespace)
APP_NAMESPACE=shopdemo

# アプリのバージョン (service.version)
APP_VERSION=1.0.0

# --- ECS ディテクタ相当の属性 (ローカル代替) ----------------------------------
#  本番では Collector の resourcedetection(detectors: [env, ecs]) が
#  ECS タスクメタデータから aws.ecs.* を拾うが、Compose にはその
#  エンドポイントが無いので ecs ディテクタを外している。
#  そのままだと Jaeger で ecs_cluster / ecs_task_family が空になり、
#  X-Ray の indexed_attributes に並べた属性をローカルで検証できない。
#  compose.yaml が下の 2 つを OTEL_RESOURCE_ATTRIBUTES へ流し込んで埋める。
#
#  既定値は本番の命名に合わせてある:
#    クラスタ名   <APP_NAMESPACE>-local
#    タスク定義名 <APP_SERVICE>-local   (本番は <APP_SERVICE>-<APP_ENV>)
#  本番と同じ文字列で検索を試したいときだけ書き換える。
#ECS_CLUSTER_NAME=shopdemo-local
#ECS_TASK_FAMILY=intra-api-local

# 上記に加えて独自のリソース属性を足したいとき (チーム名・課金タグなど)。
# 指定した内容は aws.ecs.* の後ろに追記される (置き換えではない)。
#APP_EXTRA_RESOURCE_ATTRIBUTES=team=platform,cost.center=1234

# --- 下流ノード名の多段階判定 (peer.service) ----------------------------------
#  X-Ray のサービスマップ / Jaeger の相手先ノードに出る名前を決める仕組み。
#  何も設定しないと接続先 FQDN がそのままノード名になり、環境ごとに文字列が
#  違うのでマップが読めなくなる。詳細: docs/peer-service-resolution.md
#
#  判定順 (上で決まったら以降は見ない):
#    段0 明示     APP_PEER_SERVICE_MAPPING
#    段1 役割     DB_HOST / VALKEY_HOST など変数名から用途が確定しているもの
#    段2 ドメイン APP_PEER_DOMAIN_RULES  (ホスト名の部分一致)
#    段3 ポート   APP_PEER_PORT_RULES    (ポート番号)
#    段4 AWS 自動 *.<service>.amazonaws.com からサービス名を機械的に抜く
#
#  どの段で決まったかはコンテナの起動ログ ([otel-env] peer 判定) に出る。
#  段2 以降は Collector 側 (transform/peer-service-resolve) にも同じ規則があり、
#  エージェントが決められなかったスパンをそこで拾う。両方そろえて直すこと。

# ALB の見せ方
#   upstream (既定) ALB を透過扱いし、裏の実サービス名を使う (front -> report-ec2)
#   alb             ALB 自体をノードにする            (front -> report-alb)
#  ★ どちらでも ALB のノードが AWS 側から自動で生えることは無い。
#    ALB は X-Ray にセグメントを送らないため。詳細: docs/alb-tracing.md
#APP_PEER_ALB_MODE=upstream

# 段2: ホスト名の部分一致ルール <部分文字列>=<論理名>
#  FQDN 全体を書かないので dev/stg/prd でエンドポイントが変わっても追随不要。
#APP_PEER_DOMAIN_RULES=.rds.amazonaws.com=aurora-mysql,.cache.amazonaws.com=elasticache-valkey,.elb.amazonaws.com=alb,sqs.=sqs,.s3.=s3,s3.=s3,.execute-api.=api-gateway,.secretsmanager.=secretsmanager,.dkr.ecr.=ecr

# 段3: ポート番号ルール <ポート>=<論理名>
#  ECS のタスク内は front も back も ADOT サイドカーも同じ localhost なので、
#  ポートでしか区別できない。host:port 形式のマッピングがここで効く。
#APP_PEER_PORT_RULES=3306=aurora-mysql,6379=elasticache-valkey,4317=adot-collector,4318=adot-collector,2000=adot-awsproxy

# 用途が未知の連携先を段2 以降だけで名付けさせる (host または host:port)
#APP_PEER_EXTRA_HOSTS=orders.internal.example.com:8443,10.0.3.21:6379

# 最優先の名指し対応表 (段0)。host= と host:port= のどちらでも書ける。
#APP_PEER_SERVICE_MAPPING=10.0.5.9:9000=legacy-batch-api

# --- トレースに載せるリクエスト情報 --------------------------------------------
#  ★ 自動計装だけでどこまで載るか (詳細: docs/request-attributes.md)
#      ヘッダ              載る    許可リストに書いた名前だけ
#      クエリ文字列        載る    url.query は設定不要で既定で付く
#      リクエストパラメータ 載る   servlet の capture-request-parameters。
#                                 GET のクエリと POST の
#                                 application/x-www-form-urlencoded が対象
#      ボディ (JSON 等)    載らない 自動計装には機能そのものが無い
#
#  既定の許可リストは otel-env.sh が持っている (ALB 由来のヘッダを含む)。
#  ここで指定するのは「足したいもの」だけ。
#APP_CAPTURE_REQUEST_HEADERS_EXTRA=x-tenant-id
#APP_CAPTURE_RESPONSE_HEADERS_EXTRA=
#APP_CAPTURE_CLIENT_REQUEST_HEADERS_EXTRA=
#APP_CAPTURE_CLIENT_RESPONSE_HEADERS_EXTRA=

#  ★ 認証情報を含むヘッダは許可リストに書いても取り込まれない。
#    otel-env.sh が拒否リストで機械的に弾き、Collector 側でも捨てる。
#    X-Ray に出たトレースは後から削除できないため、二重で止めている。
#APP_CAPTURE_HEADERS_DENY=authorization,proxy-authorization,cookie,set-cookie,x-api-key,x-amz-security-token,x-amz-credential,x-csrf-token,x-xsrf-token

#  リクエストパラメータ。既定は空 = 1 つも載せない。
#  ★ 業務キーだけに絞ること。個人情報を入れると消せない形で保存される。
#  ★ POST フォームを対象にする場合、アプリが生ボディ (getInputStream) を
#    読む作りだと競合しうる (エージェントが getParameterValues を呼ぶため)。
#APP_CAPTURE_REQUEST_PARAMETERS=orderid,mode

#  設定キーの版差。ADOT 2.11 系は legacy、OpenTelemetry Java 2.2x 以降は included。
#APP_CAPTURE_REQUEST_PARAMETERS_KEY=legacy

# --- イメージ -----------------------------------------------------------------
BASE_IMAGE_TAG=app-eap-base:1.0
IMAGE_PREFIX=local
IMAGE_TAG=dev

# WAR の差し替え。実プロジェクトでは各チームのビルド成果物を指す。
FRONT_WAR=dist/app.war
BACK_WAR=dist/app.war

# --- ADOT / 可視化 ------------------------------------------------------------
# ADOT Collector サイドカーのイメージ。本番タスク定義と同じタグにしておくと、
# 「ローカルでは動くのに本番で動かない」の原因からバージョン差を除ける。
ADOT_COLLECTOR_IMAGE=public.ecr.aws/aws-observability/aws-otel-collector:v0.43.3

# ADOT Java Agent のバージョン (base イメージのビルド時に取得)
#   https://github.com/aws-observability/aws-otel-java-instrumentation/releases
ADOT_JAVA_AGENT_VERSION=2.11.0

# --- ADOT の関数レベル計装 (AWS Service Events) --------------------------------
# 空 = 使わない (既定)。この場合 otel-env.sh が
#   OTEL_AWS_SERVICE_EVENTS_FUNCTION_INSTRUMENT_ENABLED=false
# を明示するので、「有効なのに対象パッケージが空」という ADOT の起動 WARN
#   ServiceEventConfig - ... PACKAGES_INCLUDE is empty ? no functions will be instrumented
# は出ない。
#
# 使う場合は対象パッケージをカンマ区切りで指定する (例: com.example.app)。
# ★ 関数単位でスパンが出るため件数が跳ね上がる = X-Ray の課金に直結する。
#   必ず絞り込むこと。
APP_SERVICE_EVENT_PACKAGES=

# --- トレース関連 WARN の抑制 --------------------------------------------------
# エージェントのログは JBoss の logging サブシステムを通らない (stderr へ直接
# 書かれる) ため、standalone.xml の filter-spec では止まらない。otel-env.sh が
# グループ名からロガー名を引いて JVM のシステムプロパティを組み立てる。
#
#   resource  EC2/ECS/EKS のメタデータが引けない … 既定 ON
#             (Compose には 169.254.170.2 が無いので毎起動必ず出る)
#   context   Scope.close 忘れ / Context 不整合   … 既定 ON
#   export    Collector へ送れない                … 既定 OFF
#             ★「X-Ray/Jaeger に出ない」の最初の手掛かりなので既定では消さない。
#               起動直後だけのノイズなら OTEL_WAIT_FOR_COLLECTOR=true で待つ方がよい
#   sampler   X-Ray 集中サンプリングの取得失敗    … 既定 OFF
#   muzzle    計装の適用失敗                      … 既定 OFF
#
# カンマ区切り / all (全部) / off (グループ抑制を使わない)
OTEL_TRACE_WARN_SUPPRESS=resource,context

# グループに無いロガーを名指しで止める (既定の抑制を残したまま足せる)。
#   書式: <ロガー名>=<レベル>,...   レベル省略時は error
# OTEL_AGENT_LOG_SUPPRESS_EXTRA=

# --- 既定 HTTPS (8443) の扱い / コンテナ起動時に entrypoint.sh が適用する ------
#   ★ CLI は起動時適用なのでビルド引数ではない。値を変えても再ビルドは不要。
#   remove   (既定) 未使用の https-listener と elytron のキーストア定義を削除。
#                   WFLYELY00023 / WFLYELY01084 の WARN が発生しなくなる。
#   keystore        8443 を残し、起動時に作業領域へ application.keystore を生成する。
#   keep            既定のまま。WARN は logging の filter-spec で抑制される。
# EAP_HTTPS_MODE=remove

# CLI 適用時の embed-server ブートログ (echo=出す / discard=捨てる)
# EAP_CLI_STDOUT=echo

JAEGER_IMAGE=jaegertracing/all-in-one:1.62.0

# --- Aurora Serverless v2 (MySQL 8.4) 相当 ------------------------------------
MYSQL_IMAGE=mysql:8.4
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=appdb
MYSQL_APP_USER=appuser
MYSQL_APP_PASSWORD=apppassword

# --- ElastiCache for Valkey 相当 ----------------------------------------------
VALKEY_IMAGE=valkey/valkey:8-alpine

# --- SQS (LocalStack) ---------------------------------------------------------
LOCALSTACK_IMAGE=localstack/localstack:3.8
SQS_QUEUE_NAME=app-queue

# --- AWS (ローカルはダミー。本番 ECS ではタスクロールで認証する) --------------
AWS_REGION=ap-northeast-1
