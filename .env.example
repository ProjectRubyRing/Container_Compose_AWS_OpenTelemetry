# =============================================================================
#  .env.example — compose.yaml が読む環境変数
#
#    cp .env.example .env  してから使う。
#
#  ★ ここに OTEL_* は書かない。
#    OTEL_* はコンテナ内の base/bin/otel-env.sh が APP_SERVICE / APP_ROLE /
#    APP_ENV / APP_NAMESPACE から導出する。ここで上書きすると命名規約が崩れる。
#    (詳細: docs/naming-convention.md)
# =============================================================================

# --- 命名規約の入力 -----------------------------------------------------------
# ローカルでどの ECS サービスを再現するか。
#   intra-api / intra-web / inter-api / sf-api
# 値を変えると Jaeger の Service 名が intra-web-front のように変わる。
APP_SERVICE=intra-api

# システム識別子 (X-Ray / Jaeger の絞り込みに使う service.namespace)
APP_NAMESPACE=shopdemo

# アプリのバージョン (service.version)
APP_VERSION=1.0.0

# --- イメージ -----------------------------------------------------------------
BASE_IMAGE_TAG=app-eap-base:1.0
IMAGE_PREFIX=local
IMAGE_TAG=dev

# WAR の差し替え。実プロジェクトでは各チームのビルド成果物を指す。
FRONT_WAR=dist/app.war
BACK_WAR=dist/app.war

# --- ADOT / 可視化 ------------------------------------------------------------
# ADOT Collector サイドカーのイメージ。本番タスク定義と同じタグにしておくと、
# 「ローカルでは動くのに本番で動かない」の原因からバージョン差を除ける。
ADOT_COLLECTOR_IMAGE=public.ecr.aws/aws-observability/aws-otel-collector:v0.43.3

# ADOT Java Agent のバージョン (base イメージのビルド時に取得)
#   https://github.com/aws-observability/aws-otel-java-instrumentation/releases
ADOT_JAVA_AGENT_VERSION=2.11.0

JAEGER_IMAGE=jaegertracing/all-in-one:1.62.0

# --- Aurora Serverless v2 (MySQL 8.4) 相当 ------------------------------------
MYSQL_IMAGE=mysql:8.4
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=appdb
MYSQL_APP_USER=appuser
MYSQL_APP_PASSWORD=apppassword

# --- ElastiCache for Valkey 相当 ----------------------------------------------
VALKEY_IMAGE=valkey/valkey:8-alpine

# --- SQS (LocalStack) ---------------------------------------------------------
LOCALSTACK_IMAGE=localstack/localstack:3.8
SQS_QUEUE_NAME=app-queue

# --- AWS (ローカルはダミー。本番 ECS ではタスクロールで認証する) --------------
AWS_REGION=ap-northeast-1
